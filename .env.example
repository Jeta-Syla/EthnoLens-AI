# Copy to .env and fill in. Never commit .env.

# LLM used for extraction and Ask EthnoLens (provider and model to be decided)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# SQLite database (default: data/ethnolens.db)
ETHNOLENS_DB=data/ethnolens.db

# Path to tesseract.exe if it is not on PATH (default: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# FastAPI address used by the Streamlit frontend
API_URL=http://localhost:8000
