# Copy to .env and fill in. Never commit .env.

# LLM used for extraction and Ask EthnoLens. Groq is OpenAI-compatible.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=

# SQLite database (default: data/ethnolens.db)
ETHNOLENS_DB=data/ethnolens.db

# Path to tesseract.exe if it is not on PATH (default: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# FastAPI address used by the Streamlit frontend
API_URL=http://localhost:8000
