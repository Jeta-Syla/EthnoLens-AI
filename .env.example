# Copy to .env and fill in. Never commit .env.

# LLM used for extraction and Ask EthnoLens (provider and model to be decided)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# SQLite database (default: data/ethnolens.db)
ETHNOLENS_DB=data/ethnolens.db

# FastAPI address used by the Streamlit frontend
API_URL=http://localhost:8000
